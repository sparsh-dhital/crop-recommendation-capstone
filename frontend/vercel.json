{
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://crop-recommendation-capstone-api.onrender.com/api/:path*"},
    {"source": "/predict", "destination": "https://crop-recommendation-capstone-api.onrender.com/predict"},
    {"source": "/login", "destination": "/index.html"}
  ],
  "headers": [{"source": "/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}]}]
}
